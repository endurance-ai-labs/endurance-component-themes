# Signs the session cookie. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
# Required on Vercel production (VERCEL_ENV=production). The process refuses
# to start without it. Locally a value is still required to mint a session.
SESSION_SECRET="local-dev-only-not-for-production"

# Who is allowed in. Defaults to endurancelabs.ai when unset.
ALLOWED_EMAIL_DOMAIN="endurancelabs.ai"

# Google sign-in. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, then add an Authorised
# redirect URI for every origin that signs in. Google does not accept
# wildcards, so each one is listed by hand:
#   http://localhost:3000/api/auth/google/callback
#   https://endurance-component-themes-gallery.vercel.app/api/auth/google/callback
#
# There is no custom domain on this project today. If one is added later,
# register that origin too:
#   https://<custom-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local / Vercel Preview only. Never set on Production (the code ignores it
# there anyway). Must be an address on ALLOWED_EMAIL_DOMAIN. Lets `npm run
# dev` sign in without a Google OAuth client. On Preview, also enable Vercel
# Authentication so this button is not public.
# DEV_LOGIN_EMAIL="alex@endurancelabs.ai"
# DEV_LOGIN_NAME="Alex Sok"
